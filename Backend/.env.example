# ChainGuard backend environment template
# Copy this file to .env and insert your actual API keys.

# Alchemy Ethereum RPC
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here
ALCHEMY_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Etherscan API
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api

# Model Configuration
MODEL_PATH=./model/htgnn_phishing.pt
MODEL_DEVICE=cpu
SUBGRAPH_HOP_DEPTH=2
MAX_NEIGHBORS=30

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# App Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
